# Étape 1 : Utiliser une image de base Python
FROM python:3.12-slim

# Étape 2 : Installer les dépendances système nécessaires (OpenCV, tiré par Ultralytics)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgl1 \
    libglib2.0-0 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Étape 3 : Créer un dossier de travail
WORKDIR /app

# Étape 4 : Installer les dépendances Python (torch CPU, Ultralytics à la version d'entraînement)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir ultralytics==8.4.174 fastapi uvicorn pillow python-multipart

# Désactiver l'installation automatique de paquets par Ultralytics à l'exécution
ENV YOLO_AUTOINSTALL=false
ENV YOLO_CONFIG_DIR=/tmp/Ultralytics

# Étape 5 : Copier le modèle et le recadrage utilisé à l'entraînement
COPY app/roi.py /app/roi.py
COPY app/model_v2.pt /app/model_v2.pt

# Étape 6 : Copier le script FastAPI
COPY app/main.py /app/main.py

HEALTHCHECK --interval=60s --timeout=5s CMD curl -fs http://localhost:9510/ || exit 1

# Étape 7 : Définir le point d'entrée pour démarrer l'API
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "9510"]
